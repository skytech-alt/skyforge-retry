// skyforge-retry
// Реализация повторов с экспоненциальной задержкой.

// Примечание: предполагается, что в SkyForge есть функция паузы (сон).
// Если она называется иначе (например, ждать()), просто замените вызов.

// skyforge-retry
// Реализация повторов с экспоненциальной задержкой.

функция с_ретраями(действие, попытки, задержка, множитель) {
    пусть текущая_задержка = задержка
    
    для i от 1 до попытки {
        попробовать {
            вернуть действие()
        } поймать ошибка {
            если i == попытки {
                бросить "Все " + строка(попытки) + " попыток исчерпаны: " + строка(ошибка)
            }
            
            // Ждём перед следующей попыткой
            сон(текущая_задержка)
            
            // Экспоненциальный рост задержки
            текущая_задержка = текущая_задержка * множитель
        }
    }
}
