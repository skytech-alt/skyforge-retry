функция с_ретраями(действие, попытки, задержка, множитель) {
    пусть текущая_задержка = задержка
    для i от 1 до попытки {
        попробовать {
            вернуть действие()
        } поймать ошибка {
            если i == попытки { бросить "Все попытки исчерпаны" }
            сон(текущая_задержка)
            текущая_задержка = текущая_задержка * множитель
        }
    }
}